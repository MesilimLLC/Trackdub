<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Single source of truth for OnnxRuntime version. Referenced by Trackdub.OnnxRuntime.Dnnl.Native.csproj and the DNNL build script.
         IMPORTANT: Keep this a literal version string. The build script (tools/onnxruntime-dnnl/Build-OnnxRuntimeDnnlNativePackage.ps1)
         reads it with a regex and will capture the raw text literally if this is set to another MSBuild property reference. -->
    <OnnxRuntimeVersion>1.31.1</OnnxRuntimeVersion>
    <!-- Native ORT version inside the Microsoft.Windows.AI.MachineLearning pin below. Bump the two together:
         EP-context artifact stamps record it, so a stale value would reuse artifacts across ORT runtimes. -->
    <WindowsMlOnnxRuntimeVersion>1.27.1</WindowsMlOnnxRuntimeVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104.7" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="ReactiveUI.Avalonia" Version="14.7.1" />
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="ReactiveUI" Version="20.1.63" />
    <!--
      Managed glossary analyzers intentionally use Lucene.NET 4.8 beta packages.
      They pull ICU4N alpha transitives, so keep them isolated to Infrastructure,
      centrally pinned here, and covered by CI runtime-load/tokenize smoke tests.
      See docs/adr/ADR-0007-managed-glossary-analyzers.md before changing them.
    -->

    <PackageVersion Include="Lucene.Net.Analysis.Common" Version="4.8.0-beta00018" />
    <PackageVersion Include="Lucene.Net.Analysis.Kuromoji" Version="4.8.0-beta00018" />
    <PackageVersion Include="Lucene.Net.Analysis.SmartCn" Version="4.8.0-beta00018" />
    <PackageVersion Include="MathNet.Numerics" Version="5.0.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="SQLite" Version="3.53.4" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <!--
      SentencePieceTokenizer (used by MadladTokenizerDecoder and OpusTokenizerDecoder) was
      introduced in the 3.x preview line and is not available in the 2.0.0 stable release.
      This pin must stay on a 3.x preview build until Microsoft ships a stable 3.x on nuget.org.
      The dotnet-libraries Azure feed in NuGet.Config provides this build.
      Upgrade path: bump to stable 3.x once it appears on nuget.org; remove the dotnet-libraries
      feed entry from NuGet.Config at that point.
    -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntimeGenAI" Version="0.18.0" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntimeGenAI.Cuda" Version="0.18.0" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntimeGenAI.Managed" Version="0.18.0" />
    <!-- GenAI built against the Windows ML runtime (one onnxruntime.dll shared with DirectML and the
         catalog EPs). Windows TFM only; the portable TFM keeps the CPU/CUDA GenAI packages. -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntimeGenAI.WinML" Version="0.18.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="3.0.0-preview.26502.1" />
    <PackageVersion Include="System.Numerics.Tensors" Version="9.0.0" />
    <!-- Linux counterpart to the Windows ML catalog: pinned OpenVINO plugin EP (install, register,
         device append). Managed-only; depends on Microsoft.ML.OnnxRuntime.Managed $(OnnxRuntimeVersion). -->
    <PackageVersion Include="LinML.Catalog" Version="0.6.0" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="$(OnnxRuntimeVersion)" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.Managed" Version="$(OnnxRuntimeVersion)" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.Gpu" Version="$(OnnxRuntimeVersion)" />
    <!-- Native CUDA/TensorRT payload for the out-of-process worker. Not a compile reference. -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.Gpu.Windows" Version="$(OnnxRuntimeVersion)" />

    <!-- Windows ML 2.4 ships ONNX Runtime 1.27.1 with DirectML. -->
    <PackageVersion Include="Microsoft.Windows.AI.MachineLearning" Version="2.4.89" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- xunit v2 kept for projects pending FsCheck 3.x API migration (App.Avalonia.Tests, Inference.Tests, Api.Billing.Tests).
         FsCheck 3.x has hard C# API breaks (Gen static class renamed, Prop class removed, LINQ comprehension changed).
         Remove once those projects are updated to FsCheck 3.x API. -->
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="FsCheck" Version="2.16.6" />
    <PackageVersion Include="FsCheck.Xunit" Version="2.16.6" />
    <PackageVersion Include="FsCheck.Xunit.v3" Version="3.3.3" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="Spectre.Console.Testing" Version="0.57.2" />
    <PackageVersion Include="System.CommandLine" Version="2.0.13" />
    <!--
      LibVLCSharp cross-platform playback (Avalonia shell only).
      LibVLC native runtimes are LGPL 2.1; bundled per-platform via NuGet.
      Windows runtime is ~100 MB and ships x64 + x86 native binaries.
      macOS runtime ships a universal dylib.
      Linux has no NuGet runtime package — the system-installed libvlc is used
      (e.g. apt install vlc / libvlc-dev). The LibVlcRuntimeLocator handles
      resolution at startup.
      See docs/third-party-runtimes.md for redistribution and license notes.
    -->
    <PackageVersion Include="LibVLCSharp" Version="3.10.2" />

    <PackageVersion Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
    <PackageVersion Include="VideoLAN.LibVLC.Mac" Version="3.1.3.1" />


    <PackageVersion Include="Avalonia.Headless" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.4" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <!-- Trackdub.WebhookDelivery (Lambda) -->
    <PackageVersion Include="Amazon.Lambda.Core" Version="2.5.0" />
    <PackageVersion Include="Amazon.Lambda.Serialization.SystemTextJson" Version="2.4.4" />
    <PackageVersion Include="Amazon.Lambda.SQSEvents" Version="2.2.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
    <!-- Trackdub.Api -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.13.0" />
    <PackageVersion Include="Stripe.net" Version="47.2.0" />
    <PackageVersion Include="AWSSDK.CloudWatch" Version="4.0.102.2" />
    <PackageVersion Include="AWSSDK.DynamoDBv2" Version="4.0.109.3" />
    <PackageVersion Include="AWSSDK.ECS" Version="4.0.6.1" />
    <PackageVersion Include="AWSSDK.SimpleNotificationService" Version="4.0.100.5" />
    <PackageVersion Include="AWSSDK.SQS" Version="4.0.2.33" />
    <PackageVersion Include="AWSSDK.EventBridge" Version="4.0.100.5" />
    <!-- GHSA-v5pm-xwqc-g5wc: Microsoft.AspNetCore.OpenApi 10.0.0 pulls vulnerable Microsoft.OpenApi 2.0.0 -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageVersion Include="Microsoft.OpenApi" Version="2.9.0" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.9" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="7.2.0" />
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <!-- Observability: structured logging -->
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
    <!-- Observability: metrics + Prometheus scraping endpoint (1.15.3+ fixes GHSA-g94r-2vxg-569j) -->

    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.16.0-beta.1" />
    <!-- Roslyn analyzer SDK for Trackdub.Analyzers + its in-tree test project. Analyzer tests use
         the in-box CSharpCompilation + GetAnalyzerDiagnosticsAsync path (no third-party test harness),
         so only the Workspaces package is needed. The CodeAnalysis.Analyzers package ships the
         RS2008 / RS2009 release-tracking analyzers that the analyzer project itself must satisfy
         when AnalyzerReleaseTracking=true. See docs/adr/ADR-0012-wave-pcm16-loudness-policy.md. -->
    <!-- Microsoft.CodeAnalysis.CSharp.Workspaces is the canonical transitive-anchor package: it brings
         the right Microsoft.CodeAnalysis 5.9.0 version + CSharp + Workspaces.Common co-versioned.
         Using this on BOTH projects eliminates the MSB3277/CS1705 version-conflict trap that occurs
         when the analyzer project references CSharp only and the test project includes CSharp directly.
         The Roslyn analyzer rules RS1038/RS1041 from Workspaces references are silenced via
         src/Trackdub.Analyzers/.editorconfig. See docs/adr/ADR-0012-wave-pcm16-loudness-policy.md. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <!-- Repo-wide banned-API analyzer (RS0030): bans Path.Combine in favor of Path.Join.
         CodeQL/CodeFactor flag every Path.Combine call whose second-or-later argument isn't
         provably non-rooted (it silently drops earlier segments if it is); Path.Join has no
         such reset behavior and is the drop-in replacement for every case in this codebase.
         Wired repo-wide via Directory.Build.props + BannedSymbols.txt so the build fails
         locally instead of catching this in CI review comments one call at a time. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="4.14.0" />
  </ItemGroup>
</Project>
