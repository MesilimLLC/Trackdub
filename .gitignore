# =============================================================================
# Trackdub .gitignore
# Keep patterns broad for generated/local junk; never ignore repo-owned tooling.
# NuGet packages.lock.json files are TRACKED (RestorePackagesWithLockFile=true).
# =============================================================================

# --- Build outputs ---
bin/
obj/
publish/
dist/
out/
TestResults/
coverage/
*.user
*.suo
*.out
*.lscache
*.csproj.lscache

# --- IDE / editor (local preferences only) ---
.vs/
.vscode/
.idea/

# --- Packages / generated artifacts ---
packages/
artifacts/
_site/
!src/**/Artifacts/
!src/**/Artifacts/**

# --- Models and large runtime assets ---
models/
!tools/models/
!src/DubBench/Models/
