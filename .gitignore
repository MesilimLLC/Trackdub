!tests/Trackdub.Inference.Onnx.Tests/Fixtures/NemotronAsr/managed-decoder.onnx
*.onnx_data
*.pt
*.pth
*.bin
*.safetensors
*.gguf
!src/Trackdub.Inference.Onnx/
!src/Trackdub.Inference.Onnx/**
src/Trackdub.Inference.Onnx/bin/
src/Trackdub.Inference.Onnx/obj/

