<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Trackdub.OnnxRuntime.Dnnl.Native</PackageId>
    <Version>$(OnnxRuntimeVersion)</Version>
    <Authors>Trackdub</Authors>
    <Description>DNNL-enabled ONNX Runtime native assets for Trackdub.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Mesililm-LLC/Trackdub</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Mesililm-LLC/Trackdub</PackageProjectUrl>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="THIRD_PARTY_NOTICES.dnnl.md" Pack="true" PackagePath="" />
    <None Include="provenance\**\*.*" Pack="true" PackagePath="provenance\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="runtimes\**\*.*" Exclude="runtimes\**\.gitkeep" Pack="true" PackagePath="runtimes\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
