<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0;net11.0-windows10.0.19041.0</TargetFrameworks>
      <!-- Directory.Build.props sets TargetFramework=net11.0; clear it so multi-target restore/build includes both legs consistently. -->
      <TargetFramework Condition="'$(TargetFrameworks)' != ''"/>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <!-- LINML: LinML.Catalog is referenced (portable TFM, any build host). Call sites gate on
       OperatingSystem.IsLinux() at run time, so the portable artifact behaves the same wherever it is built. -->
  <PropertyGroup Condition="'$(TargetFramework)' != 'net11.0-windows10.0.19041.0'">
    <DefineConstants>$(DefineConstants);LINML</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0-windows10.0.19041.0'">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TrackdubOrtRuntimeFlavor)' == 'Dnnl'">
    <DefineConstants>$(DefineConstants);TRACKDUB_ORT_DNNL</DefineConstants>
  </PropertyGroup>
  <!-- The CUDA worker compiles this project a second time against stock managed ORT 1.30.
       The Windows ML host keeps the default output, which references Windows ML's managed binding. -->
  <PropertyGroup Condition="'$(TrackdubOrtHost)' == 'Stock'">
    <OutputPath>$(MSBuildThisFileDirectory)bin\$(Configuration)\$(TargetFramework)\stock-ort\</OutputPath>
    <IntermediateOutputPath>$(MSBuildThisFileDirectory)obj\$(Configuration)\$(TargetFramework)\stock-ort\</IntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Trackdub.Inference.Onnx.Tests" />
    <ProjectReference Include="..\Trackdub.Contracts\Trackdub.Contracts.csproj" />
    <ProjectReference Include="..\Trackdub.Domain\Trackdub.Domain.csproj" />
    <ProjectReference Include="..\Trackdub.Inference\Trackdub.Inference.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="TrackdubHostOrtRuntimeVersion" Value="$(OnnxRuntimeVersion)"
                      Condition="'$(TrackdubOrtHost)' == 'Stock'" />
    <AssemblyMetadata Include="TrackdubHostOrtRuntimeVersion" Value="$(WindowsMlOnnxRuntimeVersion)"
                      Condition="'$(TrackdubOrtHost)' != 'Stock' And '$(TargetFramework)' == 'net11.0-windows10.0.19041.0'" />
    <AssemblyMetadata Include="TrackdubHostOrtRuntimeVersion" Value="$(OnnxRuntimeVersion)"
                      Condition="'$(TrackdubOrtHost)' != 'Stock' And '$(TargetFramework)' != 'net11.0-windows10.0.19041.0'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" />
    <PackageReference Include="Microsoft.ML.Tokenizers" />
    <PackageReference Include="System.Numerics.Tensors" />
  </ItemGroup>

  <!-- DNNL flavor still needs managed ORT/WinML/GenAI compile references, but the runtime
       payload comes from Trackdub.OnnxRuntime.Dnnl.Native instead of stock ORT packages. -->
  <ItemGroup>
    <PackageReference Update="Microsoft.Windows.AI.MachineLearning"
                      Condition="'$(TrackdubOrtRuntimeFlavor)' == 'Dnnl'"
                      ExcludeAssets="runtime" />
    <PackageReference Update="Microsoft.ML.OnnxRuntimeGenAI"
                      Condition="'$(TrackdubOrtRuntimeFlavor)' == 'Dnnl'"
                      ExcludeAssets="runtime" />
    <PackageReference Update="Microsoft.ML.OnnxRuntimeGenAI.WinML"
                      Condition="'$(TrackdubOrtRuntimeFlavor)' == 'Dnnl'"
                      ExcludeAssets="runtime" />
    <PackageReference Update="Microsoft.ML.OnnxRuntime.Gpu"
                      Condition="'$(TrackdubOrtRuntimeFlavor)' == 'Dnnl'"
                      ExcludeAssets="runtime" />
    <PackageReference Update="Microsoft.ML.OnnxRuntimeGenAI.Cuda"
                      Condition="'$(TrackdubOrtRuntimeFlavor)' == 'Dnnl'"
                      ExcludeAssets="runtime" />
    <PackageReference Update="Microsoft.ML.OnnxRuntime"
                      Condition="'$(TrackdubOrtRuntimeFlavor)' == 'Dnnl'"
                      ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Windows: Windows ML owns the ORT environment and catalog EP registration, and GenAI runs on the
       same Windows ML runtime through its .WinML package. The Windows ML package's lib folder is the
       managed Microsoft.ML.OnnxRuntime.dll (native 1.27.1). Stock ORT 1.30's managed binding is not
       referenced here, so it cannot win the compile or the app output. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0-windows10.0.19041.0'">
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI.WinML" GeneratePathProperty="true" />
    <!-- Restored so the worker and native-pair hash can see the CUDA build. Assets stay out of this project. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu.Windows" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
    <!-- Stock managed binding for the worker host only. ExcludeAssets keeps it out of the Windows ML host graph. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <!-- DNNL excludes Windows ML's runtime assets and its native package ships no managed binding, so
       the stock managed Microsoft.ML.OnnxRuntime.dll has to reach the app output (compile still
       binds against the Windows ML lib reference above). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0-windows10.0.19041.0' And '$(TrackdubOrtRuntimeFlavor)' == 'Dnnl'">
    <PackageReference Update="Microsoft.ML.OnnxRuntime.Managed" ExcludeAssets="compile" PrivateAssets="compile" />
  </ItemGroup>

  <!-- Keep the portable TFM's package graph identical across restore hosts. Locked restores use
       one net11.0 graph; runtime asset selection below remains RID-specific. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net11.0-windows10.0.19041.0'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" />
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI.Cuda" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI" GeneratePathProperty="true" />
    <PackageReference Include="LinML.Catalog" />
  </ItemGroup>

  <!-- Non-Windows: exclude Windows-specific sources -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net11.0-windows10.0.19041.0'">
    <Compile Remove="ExecutionProviders\Windows\**" />
    <Compile Remove="WindowsMl\**" />
    <Compile Remove="Migraphx\WindowsMlMigraphxCatalogService.cs" />
    <Compile Remove="Migraphx\WindowsMigraphxHardwareGate.cs" />
    <Compile Remove="NativeCudaTensorRt\**" />
    <Compile Remove="Runtime\WindowsDeviceEnumerator.cs" />
    <Compile Remove="Runtime\WindowsEcoQos.cs" />
    <Compile Remove="Runtime\WindowsVramMonitor.cs" />
    <Compile Remove="OnnxModelBenchmarkRunner.cs" />
  </ItemGroup>

  <!-- Linux and macOS sources compile on every build host; the portable TFM selects them with
       OperatingSystem.IsLinux() / IsMacOS() at run time, so the artifact does not depend on where
       it was built. -->

  <!-- Windows: remove the deferred WinML stub (compiled separately) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0-windows10.0.19041.0'">
    <Compile Remove="WindowsMl\WindowsMlExecutionProviderBootstrapper.Deferred.cs" />
    <!-- LinML.Catalog is portable-TFM only; Windows uses the Windows ML catalog. -->
    <Compile Remove="ExecutionProviders\LinMl\LinMl*.cs" />
  </ItemGroup>

  <Import Project="../../build/Trackdub.NativePair.targets" />

  <!-- NuGet selects Windows ML's managed ORT for this TFM. The worker host swaps that reference
       for stock ORT 1.30 so its compile identity matches the CUDA native it loads. -->
  <!-- The inference worker handshake compares this source revision (InferenceWorkerProtocol.BuildStamp).
       The application's and the worker's compilations of this assembly share it, unlike their module IDs. -->
  <Target Name="StampTrackdubSourceRevision"
          DependsOnTargets="AddSourceRevisionToInformationalVersion"
          BeforeTargets="GetAssemblyAttributes"
          Condition="'$(GenerateAssemblyInfo)' != 'false'">
    <ItemGroup Condition="'$(SourceRevisionId)' != ''">
      <AssemblyMetadata Include="TrackdubSourceRevision" Value="$(SourceRevisionId)" />
    </ItemGroup>
  </Target>

  <Target Name="ReferenceStockManagedOrt"
          AfterTargets="ResolveAssemblyReferences"
          BeforeTargets="FindReferenceAssembliesForReferences"
          Condition="'$(TrackdubOrtHost)' == 'Stock'">
    <ItemGroup>
      <ReferencePath Remove="@(ReferencePath)" Condition="'%(Filename)' == 'Microsoft.ML.OnnxRuntime'" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'Microsoft.ML.OnnxRuntime'" />
      <ReferencePath Include="$(PkgMicrosoft_ML_OnnxRuntime_Managed)\lib\net8.0\Microsoft.ML.OnnxRuntime.dll" />
      <ReferenceCopyLocalPaths Include="$(PkgMicrosoft_ML_OnnxRuntime_Managed)\lib\net8.0\Microsoft.ML.OnnxRuntime.dll">
        <Private>true</Private>
      </ReferenceCopyLocalPaths>
    </ItemGroup>
    <Error Condition="!Exists('$(PkgMicrosoft_ML_OnnxRuntime_Managed)\lib\net8.0\Microsoft.ML.OnnxRuntime.dll')"
           Text="Stock managed ORT was not restored at $(PkgMicrosoft_ML_OnnxRuntime_Managed)\lib\net8.0\Microsoft.ML.OnnxRuntime.dll." />
  </Target>
</Project>
