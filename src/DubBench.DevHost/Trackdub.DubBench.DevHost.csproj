<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">WinExe</OutputType>
    <OutputType Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'">Exe</OutputType>
    <TargetFrameworks>net11.0;net11.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFramework Condition="'$(TargetFrameworks)' != ''" />
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DubBench\Trackdub.DubBench.csproj" />
    <ProjectReference Include="..\Trackdub.Infrastructure\Trackdub.Infrastructure.csproj" />
    <PackageReference Include="Avalonia.Desktop" />
    <!-- Keep the package graph stable for lock-file restore, but don't consume or ship
         developer-tool assets in Release. Program enables the tools only under DEBUG. -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <ExcludeAssets Condition="'$(Configuration)' == 'Release'">all</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Release publish: precompile managed assemblies for faster cold start (dotnet publish -c Release).
       Mirrors Trackdub-gated's desktop app publish setting. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' != ''">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
</Project>
