<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Trackdub.Application\Trackdub.Application.csproj" />
    <ProjectReference Include="..\Trackdub.Composition\Trackdub.Composition.csproj" />
    <ProjectReference Include="..\Trackdub.Domain\Trackdub.Domain.csproj" />
    <ProjectReference Include="..\Trackdub.Inference\Trackdub.Inference.csproj" />
    <ProjectReference Include="..\Trackdub.Inference.Onnx\Trackdub.Inference.Onnx.csproj" />
    <ProjectReference Include="..\Trackdub.Infrastructure\Trackdub.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\runtime\trt-rtx-ep.manifest.json" Link="trt-rtx-ep.manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="Trackdub.Benchmarks.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net11.0;net11.0-windows10.0.19041.0</TargetFrameworks>
      <!-- Directory.Build.props sets TargetFramework=net11.0; clear it so multi-target restore/build includes both legs consistently. -->
      <TargetFramework Condition="'$(TargetFrameworks)' != ''"/>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0-windows10.0.19041.0'">
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <!-- Release publish: precompile managed assemblies for faster cold start (dotnet publish -c Release). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' != ''">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0-windows10.0.19041.0'">
    <ProjectReference Update="..\Trackdub.Inference.Onnx\Trackdub.Inference.Onnx.csproj"
                      SetTargetFramework="TargetFramework=net11.0-windows10.0.19041.0" />
    <ProjectReference Update="..\Trackdub.Composition\Trackdub.Composition.csproj"
                      SetTargetFramework="TargetFramework=net11.0-windows10.0.19041.0" />
  </ItemGroup>

</Project>
