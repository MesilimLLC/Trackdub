<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net11.0;net11.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFramework Condition="'$(TargetFrameworks)' != ''" />
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>trackdub</ToolCommandName>
    <PackageId>Trackdub.Cli</PackageId>
    <Authors>Trackdub</Authors>
    <Description>Trackdub command-line interface for the local-first AI dubbing pipeline.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Mesililm-LLC/Trackdub</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Mesililm-LLC/Trackdub</PackageProjectUrl>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0-windows10.0.19041.0'">
    <WindowsPackageType>None</WindowsPackageType>
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    <!-- Headless unpackaged CLI: Composition/Sdk own WinML bootstrap; skip entry-exe auto-init. -->
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
  </PropertyGroup>

  <!-- Release publish: precompile managed assemblies for faster cold start (dotnet publish -c Release).
       Mirrors Trackdub-gated's desktop app publish setting; build/test/CI runs are unaffected. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' != ''">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Trackdub.Sdk.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Trackdub.Sdk\Trackdub.Sdk.csproj">
      <SetTargetFramework>TargetFramework=$(TargetFramework)</SetTargetFramework>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

</Project>
