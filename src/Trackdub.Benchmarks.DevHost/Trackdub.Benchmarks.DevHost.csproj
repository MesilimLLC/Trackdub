<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net11.0;net11.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFramework Condition="'$(TargetFrameworks)' != ''" />
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Trackdub.Benchmarks\Trackdub.Benchmarks.csproj" />
  </ItemGroup>

  <!-- Release publish: precompile managed assemblies for faster cold start (dotnet publish -c Release). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' != ''">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
</Project>
