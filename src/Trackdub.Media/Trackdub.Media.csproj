<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Trackdub.Application\Trackdub.Application.csproj" />
    <ProjectReference Include="..\Trackdub.Contracts\Trackdub.Contracts.csproj" />
    <ProjectReference Include="..\Trackdub.Domain\Trackdub.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- WavePcm16MultiSourceMixOptInAnalyzer: see docs/adr/ADR-0012-wave-pcm16-loudness-policy.md.
         OutputItemType=Analyzer + ReferenceOutputAssembly=false keeps the analyzer DLL out of the
         runtime/compile-reference surface while loading its analyzers into the compile graph. -->
    <ProjectReference Include="..\Trackdub.Analyzers\Trackdub.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
