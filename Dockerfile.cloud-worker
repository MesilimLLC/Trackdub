ARG SERVER_IMAGE
FROM mcr.microsoft.com/dotnet/sdk:11.0.100-rc.3@sha256:3a9175b6c54b2f076817af1360f691c9994447b192faa48a1a1f112a516844c7 AS build
WORKDIR /src
COPY . .
RUN dotnet publish src/Trackdub.CloudJobAdapter/Trackdub.CloudJobAdapter.csproj -c Release -o /out -m:1

# Required: approved server image digest built with this revision's CLI machine protocol.
FROM ${SERVER_IMAGE}
COPY --from=build --chown=10001:10001 /out /app/adapter/
RUN test -x /usr/bin/setsid \
    && dotnet /app/Trackdub.Cli.dll run pipeline --help > /tmp/trackdub-machine-help.txt \
    && grep -F -- '--result-file' /tmp/trackdub-machine-help.txt \
    && grep -F -- '--progress-file' /tmp/trackdub-machine-help.txt \
    && rm /tmp/trackdub-machine-help.txt
USER 10001:10001
ENTRYPOINT ["dotnet", "/app/adapter/Trackdub.CloudJobAdapter.dll"]
CMD []
