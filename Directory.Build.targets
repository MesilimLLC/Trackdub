<Project>
  <!-- Strip Windows TFM on non-Windows to allow cross-platform solution builds.
       Locked-restore callers set TrackdubRestoreAllTargetFrameworks=true so
       even the outer restore evaluation retains the full framework graph.
       Also skip strip during restore (MSBuildRestoreSessionId set) so locked-mode
       matches committed multi-TFM packages.lock.json graphs. Build/test still strip.
       Trim(';') handles Avalonia-style "net11.0-windows...;net11.0" ordering. -->
  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows')) AND '$(TargetFrameworks)' != '' AND '$(MSBuildRestoreSessionId)' == '' AND '$(TrackdubRestoreAllTargetFrameworks)' != 'true'">
    <TargetFrameworks>$([System.Text.RegularExpressions.Regex]::Replace('$(TargetFrameworks)', ';?net11\.0-windows[^;]*', '').Trim(';'))</TargetFrameworks>
  </PropertyGroup>
  <!-- Keep duplicate CPU ONNX Runtime assets out of publish output when the
       runtime package graph also contains DirectML/Windows ML assets. -->
  <Target Name="RemoveDuplicateCpuOnnxRuntimePublishAssets" BeforeTargets="_HandleFileConflictsForPublish">
    <ItemGroup>
      <!-- Collect ONNX DLL filenames that come from a non-CPU source (DirectML, WinML, etc.).
           Path is normalised to forward-slashes so the check works on all platforms. -->
      <_NonCpuOnnxDll Include="%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)"
          Condition="('%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'onnxruntime.dll' or
                      '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'onnxruntime_providers_shared.dll') and
                     !$([System.String]::Copy('%(ResolvedFileToPublish.Identity)').ToLowerInvariant().Replace('\', '/').Contains('/microsoft.ml.onnxruntime/'))" />
    </ItemGroup>
    <!-- Only remove the CPU copies when an alternative provider also supplies the same DLL,
         so a project that depends solely on the CPU package is never broken. -->
    <ItemGroup Condition="'@(_NonCpuOnnxDll)' != ''">
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="$([System.String]::Copy('%(ResolvedFileToPublish.Identity)').ToLowerInvariant().Replace('\', '/').Contains('/microsoft.ml.onnxruntime/')) and
                     ('%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'onnxruntime.dll' or
                      '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'onnxruntime_providers_shared.dll')" />
    </ItemGroup>
  </Target>

  <!-- GenAI.Cuda and base GenAI both ship onnxruntime-genai native assets. On Linux publish
       Composition historically pulled base GenAI while Inference.Onnx pulls GenAI.Cuda, which
       triggers NETSDK1152 for the same publish-relative path. Prefer Cuda when both appear. -->
  <Target Name="RemoveDuplicateGenAiPublishAssets" BeforeTargets="_HandleFileConflictsForPublish">
    <ItemGroup>
      <_CudaGenAiAsset Include="%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)"
          Condition="('%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'onnxruntime-genai.dll' or
                      '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'libonnxruntime-genai.so') and
                     $([System.String]::Copy('%(ResolvedFileToPublish.Identity)').ToLowerInvariant().Replace('\', '/').Contains('/microsoft.ml.onnxruntimegenai.cuda/'))" />
    </ItemGroup>
    <ItemGroup Condition="'@(_CudaGenAiAsset)' != ''">
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="$([System.String]::Copy('%(ResolvedFileToPublish.Identity)').ToLowerInvariant().Replace('\', '/').Contains('/microsoft.ml.onnxruntimegenai/')) and
                     !$([System.String]::Copy('%(ResolvedFileToPublish.Identity)').ToLowerInvariant().Replace('\', '/').Contains('/microsoft.ml.onnxruntimegenai.cuda/')) and
                     ('%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'onnxruntime-genai.dll' or
                      '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'libonnxruntime-genai.so')" />
    </ItemGroup>
  </Target>

  <!-- Copy portable CUDA and GenAI native DLLs into the exe/test output directory. This in-place
       copy overwrites same-named runtime DLLs already in that directory. -->
  <Target Name="ResolvePortableWindowsCudaGenAiNativeFiles"
          Condition="'$(TrackdubWindowsCudaGenAi)' == 'true' And '$(TargetFramework)' == 'net11.0' And
                     $([MSBuild]::IsOSPlatform('Windows')) And
                     ('$(OutputType)' == 'Exe' Or '$(IsTestProject)' == 'true') And
                     '$(TrackdubOrtRuntimeFlavor)' != 'Dnnl' And
                     ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'win-x64') And
                     '$(PlatformTarget)' != 'ARM64'">
    <PropertyGroup>
      <_PortableCudaOrtDir>$([System.IO.Path]::Join('$(NuGetPackageRoot)', 'microsoft.ml.onnxruntime.gpu.windows', '$(OnnxRuntimeVersion)', 'runtimes/win-x64/native'))</_PortableCudaOrtDir>
      <_PortableCudaGenAiDir>$([System.IO.Path]::Join('$(NuGetPackageRoot)', 'microsoft.ml.onnxruntimegenai.cuda', '$(OnnxRuntimeGenAiCudaVersion)', 'runtimes/win-x64/native'))</_PortableCudaGenAiDir>
    </PropertyGroup>
    <Error Condition="!Exists('$(_PortableCudaOrtDir)/onnxruntime_providers_cuda.dll') Or !Exists('$(_PortableCudaGenAiDir)/onnxruntime-genai-cuda.dll')"
           Text="Restore the pinned Windows CUDA ONNX Runtime and GenAI packages before building the portable CUDA host." />
    <ItemGroup>
      <_PortableCudaNative Include="$(_PortableCudaOrtDir)/onnxruntime.dll;
                                   $(_PortableCudaOrtDir)/onnxruntime_providers_shared.dll;
                                   $(_PortableCudaOrtDir)/onnxruntime_providers_cuda.dll;
                                   $(_PortableCudaGenAiDir)/onnxruntime-genai.dll;
                                   $(_PortableCudaGenAiDir)/onnxruntime-genai-cuda.dll" />
    </ItemGroup>
  </Target>

  <Target Name="StagePortableWindowsCudaGenAi"
          AfterTargets="CopyFilesToOutputDirectory"
          BeforeTargets="IncludePortableWindowsCudaGenAiPublishFiles"
          DependsOnTargets="ResolvePortableWindowsCudaGenAiNativeFiles"
          Condition="'$(TrackdubWindowsCudaGenAi)' == 'true' And '$(TargetFramework)' == 'net11.0' And
                     $([MSBuild]::IsOSPlatform('Windows')) And
                     ('$(OutputType)' == 'Exe' Or '$(IsTestProject)' == 'true') And
                     '$(TrackdubOrtRuntimeFlavor)' != 'Dnnl' And
                     ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'win-x64') And
                     '$(PlatformTarget)' != 'ARM64'">
    <Copy SourceFiles="@(_PortableCudaNative)" DestinationFolder="$(TargetDir)" />
  </Target>

  <Target Name="IncludePortableWindowsCudaGenAiPublishFiles"
          BeforeTargets="_HandleFileConflictsForPublish"
          DependsOnTargets="ResolvePortableWindowsCudaGenAiNativeFiles"
          Condition="'$(TrackdubWindowsCudaGenAi)' == 'true' And '$(TargetFramework)' == 'net11.0' And
                     $([MSBuild]::IsOSPlatform('Windows')) And
                     ('$(OutputType)' == 'Exe' Or '$(IsTestProject)' == 'true') And
                     '$(TrackdubOrtRuntimeFlavor)' != 'Dnnl' And
                     ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'win-x64') And
                     '$(PlatformTarget)' != 'ARM64'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)%(Extension)' == 'onnxruntime.dll' Or
                                        '%(Filename)%(Extension)' == 'onnxruntime_providers_shared.dll' Or
                                        '%(Filename)%(Extension)' == 'onnxruntime_providers_cuda.dll' Or
                                        '%(Filename)%(Extension)' == 'onnxruntime-genai.dll' Or
                                        '%(Filename)%(Extension)' == 'onnxruntime-genai-cuda.dll'" />
      <ResolvedFileToPublish Include="@(_PortableCudaNative)">
        <RelativePath>%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!-- Windows GenAI CPU loader dynamically loads onnxruntime-genai-cuda.dll for NvTensorRtRtx.
       Copy that sidecar next to onnxruntime-genai.dll without taking Cuda's onnxruntime-genai.dll
       or its Microsoft.ML.OnnxRuntime.Gpu 1.28 graph. -->
  <Target Name="AddGenAiCudaSidecarToOutputItems"
          BeforeTargets="GetCopyToOutputDirectoryItems"
          Condition="'$(TargetFramework)' == 'net11.0-windows10.0.19041.0' And '$(TrackdubOrtRuntimeFlavor)' != 'Dnnl' And '$(PkgMicrosoft_ML_OnnxRuntimeGenAI_Cuda)' != ''">
    <ItemGroup>
      <_GenAiCudaSidecar Include="$(PkgMicrosoft_ML_OnnxRuntimeGenAI_Cuda)\runtimes\win-x64\native\onnxruntime-genai-cuda.dll"
                         Condition="Exists('$(PkgMicrosoft_ML_OnnxRuntimeGenAI_Cuda)\runtimes\win-x64\native\onnxruntime-genai-cuda.dll')"
                         Rid="win-x64" />
      <_GenAiCudaSidecar Include="$(PkgMicrosoft_ML_OnnxRuntimeGenAI_Cuda)\runtimes\win-arm64\native\onnxruntime-genai-cuda.dll"
                         Condition="Exists('$(PkgMicrosoft_ML_OnnxRuntimeGenAI_Cuda)\runtimes\win-arm64\native\onnxruntime-genai-cuda.dll')"
                         Rid="win-arm64" />
      <ContentWithTargetPath Include="@(_GenAiCudaSidecar)"
                             CopyToOutputDirectory="PreserveNewest"
                             TargetPath="runtimes\%(_GenAiCudaSidecar.Rid)\native\onnxruntime-genai-cuda.dll"
                             Visible="false" />
      <ContentWithTargetPath Include="@(_GenAiCudaSidecar)"
                             CopyToOutputDirectory="PreserveNewest"
                             TargetPath="onnxruntime-genai-cuda.dll"
                             Visible="false"
                             Condition="'$(RuntimeIdentifier)' == '' AND '%(_GenAiCudaSidecar.Rid)' == 'win-x64'" />
      <ContentWithTargetPath Include="@(_GenAiCudaSidecar)"
                             CopyToOutputDirectory="PreserveNewest"
                             TargetPath="onnxruntime-genai-cuda.dll"
                             Visible="false"
                             Condition="'$(RuntimeIdentifier)' != '' AND '%(_GenAiCudaSidecar.Rid)' == '$(RuntimeIdentifier)'" />
    </ItemGroup>
  </Target>

  <Target Name="CopyGenAiCudaSidecarToOutput"
          AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(OS)' == 'Windows_NT' And '$(TargetFramework)' == 'net11.0-windows10.0.19041.0' And '$(TrackdubOrtRuntimeFlavor)' != 'Dnnl' And '$(PkgMicrosoft_ML_OnnxRuntimeGenAI_Cuda)' != ''">
    <ItemGroup>
      <_GenAiCudaSidecarCopy Include="$(PkgMicrosoft_ML_OnnxRuntimeGenAI_Cuda)\runtimes\win-x64\native\onnxruntime-genai-cuda.dll"
                             Condition="Exists('$(PkgMicrosoft_ML_OnnxRuntimeGenAI_Cuda)\runtimes\win-x64\native\onnxruntime-genai-cuda.dll')"
                             Rid="win-x64" />
      <_GenAiCudaSidecarCopy Include="$(PkgMicrosoft_ML_OnnxRuntimeGenAI_Cuda)\runtimes\win-arm64\native\onnxruntime-genai-cuda.dll"
                             Condition="Exists('$(PkgMicrosoft_ML_OnnxRuntimeGenAI_Cuda)\runtimes\win-arm64\native\onnxruntime-genai-cuda.dll')"
                             Rid="win-arm64" />
    </ItemGroup>
    <Copy SourceFiles="@(_GenAiCudaSidecarCopy)"
          DestinationFiles="@(_GenAiCudaSidecarCopy->'$(TargetDir)runtimes\%(Rid)\native\onnxruntime-genai-cuda.dll')"
          OverwriteReadOnlyFiles="true"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_GenAiCudaSidecarCopy)"
          DestinationFiles="@(_GenAiCudaSidecarCopy->'$(TargetDir)$(TargetName)\runtimes\%(Rid)\native\onnxruntime-genai-cuda.dll')"
          OverwriteReadOnlyFiles="true"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <_GenAiCudaSidecarRoot Include="@(_GenAiCudaSidecarCopy)"
                             Condition="'$(RuntimeIdentifier)' == '' AND '%(Rid)' == 'win-x64'" />
      <_GenAiCudaSidecarRoot Include="@(_GenAiCudaSidecarCopy)"
                             Condition="'$(RuntimeIdentifier)' != '' AND '%(Rid)' == '$(RuntimeIdentifier)'" />
    </ItemGroup>
    <Copy SourceFiles="@(_GenAiCudaSidecarRoot)"
          DestinationFiles="$(TargetDir)onnxruntime-genai-cuda.dll"
          OverwriteReadOnlyFiles="true"
          SkipUnchangedFiles="true"
          Condition="'@(_GenAiCudaSidecarRoot)' != ''" />
    <Copy SourceFiles="@(_GenAiCudaSidecarRoot)"
          DestinationFiles="$(TargetDir)$(TargetName)\onnxruntime-genai-cuda.dll"
          OverwriteReadOnlyFiles="true"
          SkipUnchangedFiles="true"
          Condition="'@(_GenAiCudaSidecarRoot)' != ''" />
  </Target>
</Project>
