<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0;net11.0-windows10.0.19041.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0-windows10.0.19041.0'">
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="FsCheck.Xunit" />
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI" Condition="'$(TargetFramework)' == 'net11.0'" />
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI.Managed" Condition="'$(TargetFramework)' == 'net11.0-windows10.0.19041.0'" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Condition="'$(TargetFramework)' == 'net11.0-windows10.0.19041.0'" ExcludeAssets="native" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Trackdub.Application\Trackdub.Application.csproj" />
    <ProjectReference Include="..\..\src\Trackdub.Inference\Trackdub.Inference.csproj" />
    <ProjectReference Include="..\..\src\Trackdub.Inference.Onnx\Trackdub.Inference.Onnx.csproj" />
    <ProjectReference Include="..\..\src\Trackdub.Infrastructure\Trackdub.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Trackdub.Domain\Trackdub.Domain.csproj" />
    <ProjectReference Include="..\..\src\Trackdub.Composition\Trackdub.Composition.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0-windows10.0.19041.0'">
    <ProjectReference Update="..\..\src\Trackdub.Inference.Onnx\Trackdub.Inference.Onnx.csproj"
                      SetTargetFramework="TargetFramework=net11.0-windows10.0.19041.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <Compile Remove="DeviceEnumeratorClassificationPropertyTests.cs" />
    <Compile Remove="WindowsMlProviderRegistrationPolicyTests.cs" />
  </ItemGroup>

  <!-- LinML.Catalog is referenced by the portable TFM only. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0-windows10.0.19041.0'">
    <Compile Remove="LinMlOpenVinoCatalogTests.cs" />
    <Compile Remove="LinMlMigraphxCatalogTests.cs" />
    <Compile Remove="LinMlTensorRtRtxBootstrapTests.cs" />
    <Compile Remove="LinMlBuiltInProvidersTests.cs" />
    <Compile Remove="LinMlWsl2TensorRtRtxPluginTests.cs" />
    <Compile Remove="LinuxOpenVinoSessionE2ETests.cs" />
  </ItemGroup>

  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Linux'))">
    <Compile Remove="LinuxDeviceEnumeratorTests.cs" />
    <Compile Remove="LinuxExecutionProviderBootstrapperTests.cs" />
    <Compile Remove="LinMlOpenVinoCatalogTests.cs" />
    <Compile Remove="LinMlMigraphxCatalogTests.cs" />
    <Compile Remove="MigraphxReadinessProbeLinuxTests.cs" />
    <Compile Remove="LinuxOpenVinoSessionE2ETests.cs" />
  </ItemGroup>

  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('OSX'))">
    <Compile Remove="MacDeviceEnumeratorTests.cs" />
    <Compile Remove="MacExecutionProviderBootstrapperTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Trackdub.TestDoubles\FakeDeviceEnumerator.cs" Link="TestDoubles\FakeDeviceEnumerator.cs" />
    <Compile Include="..\Trackdub.TestDoubles\RequiresBundledModelFactAttribute.cs" Link="TestDoubles\RequiresBundledModelFactAttribute.cs" />
    <Compile Include="..\Trackdub.TestDoubles\SparseWaveStream.cs" Link="TestDoubles\SparseWaveStream.cs" />
  </ItemGroup>

  <!-- Windows tests use the same Windows ML / GenAI.WinML native pair as production. -->

</Project>
