<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0;net11.0-windows10.0.19041.0</TargetFrameworks>
    <!-- Directory.Build.props supplies TargetFramework; clear it when multi-targeting. -->
    <TargetFramework Condition="'$(TargetFrameworks)' != ''" />
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Legacy composition tests still have many setup/helper calls with omitted optional CancellationToken parameters. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework) == 'net11.0-windows10.0.19041.0'">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Trackdub.Application\Trackdub.Application.csproj" />
    <ProjectReference Include="..\..\src\Trackdub.Composition\Trackdub.Composition.csproj" />
    <ProjectReference Include="..\..\src\Trackdub.Contracts\Trackdub.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Trackdub.Infrastructure\Trackdub.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Trackdub.Inference.Onnx\Trackdub.Inference.Onnx.csproj" />
    <ProjectReference Include="..\..\src\Trackdub.Media\Trackdub.Media.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0-windows10.0.19041.0'">
    <ProjectReference Update="..\..\src\Trackdub.Composition\Trackdub.Composition.csproj"
                      SetTargetFramework="TargetFramework=net11.0-windows10.0.19041.0" />
    <ProjectReference Update="..\..\src\Trackdub.Inference.Onnx\Trackdub.Inference.Onnx.csproj"
                      SetTargetFramework="TargetFramework=net11.0-windows10.0.19041.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\runtime\trt-rtx-ep.manifest.json" Link="trt-rtx-ep.manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Trackdub.TestDoubles\FakeConsentService.cs" Link="TestDoubles\FakeConsentService.cs" />
    <Compile Include="..\Trackdub.TestDoubles\FakeModelInventoryService.cs" Link="TestDoubles\FakeModelInventoryService.cs" />
    <Compile Include="..\Trackdub.TestDoubles\FakeHardwareCapabilities.cs" Link="TestDoubles\FakeHardwareCapabilities.cs" />
    <Compile Include="..\Trackdub.TestDoubles\RequiresBundledModelFactAttribute.cs" Link="TestDoubles\RequiresBundledModelFactAttribute.cs" />
    <Compile Include="..\Trackdub.TestDoubles\FakeHardwareProfilerService.cs" Link="TestDoubles\FakeHardwareProfilerService.cs" />
    <Compile Include="..\Trackdub.TestDoubles\FakeStudioSettingsService.cs" Link="TestDoubles\FakeStudioSettingsService.cs" />
    <Compile Include="..\Trackdub.TestDoubles\FakeCloudEgressConsentService.cs" Link="TestDoubles\FakeCloudEgressConsentService.cs" />
    <Compile Include="..\Trackdub.TestDoubles\NullModelHashVerifier.cs" Link="TestDoubles\NullModelHashVerifier.cs" />
    <Compile Include="..\Trackdub.TestDoubles\ConfigurableModelHashVerifier.cs" Link="TestDoubles\ConfigurableModelHashVerifier.cs" />
    <Compile Include="..\Trackdub.TestDoubles\FakeArtifactStore.cs" Link="TestDoubles\FakeArtifactStore.cs" />
    <Compile Include="..\Trackdub.TestDoubles\FakeProjectStageRunStore.cs" Link="TestDoubles\FakeProjectStageRunStore.cs" />
    <Compile Include="..\Trackdub.TestDoubles\FakeLipSyncSegmentRepository.cs" Link="TestDoubles\FakeLipSyncSegmentRepository.cs" />
    <Compile Include="..\Trackdub.TestDoubles\FakeLipSynthesisSegmentRepository.cs" Link="TestDoubles\FakeLipSynthesisSegmentRepository.cs" />
    <Compile Include="..\Trackdub.TestDoubles\FakeMediaAssetRepository.cs" Link="TestDoubles\FakeMediaAssetRepository.cs" />
  </ItemGroup>

</Project>
