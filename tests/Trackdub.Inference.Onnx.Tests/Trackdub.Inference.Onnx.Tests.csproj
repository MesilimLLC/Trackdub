<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0;net11.0-windows10.0.19041.0</TargetFrameworks>
    <!-- Directory.Build.props supplies TargetFramework; clear it when multi-targeting. -->
    <TargetFramework Condition="'$(TargetFrameworks)' != ''" />
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xUnit3003: custom FactAttribute subclasses need a source-info constructor in xunit v3.
         Suppressed pending a dedicated pass to add CallerFilePath/CallerLineNumber constructors. -->
    <NoWarn>$(NoWarn);xUnit3003</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0-windows10.0.19041.0'">
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Fixtures\NemotronAsr\*.onnx" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures\Mel\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Trackdub.Contracts\Trackdub.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Trackdub.Inference.Onnx\Trackdub.Inference.Onnx.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0-windows10.0.19041.0'">
    <ProjectReference Update="..\..\src\Trackdub.Inference.Onnx\Trackdub.Inference.Onnx.csproj"
                      SetTargetFramework="TargetFramework=net11.0-windows10.0.19041.0" />
  </ItemGroup>

  <!-- WindowsMlEnsureReady is in the Windows-only WindowsMl/ directory (Compile Remove on
       the portable TFM in the production csproj), so its tests only run on the Windows TFM. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net11.0-windows10.0.19041.0'">
    <Compile Remove="WindowsMlEnsureReadyProgressTests.cs" />
  </ItemGroup>

</Project>
