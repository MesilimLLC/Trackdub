<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Legacy infrastructure tests still have many setup/helper calls with omitted optional CancellationToken parameters. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Trackdub.TestDoubles\FakeVoiceCatalog.cs" Link="TestDoubles\FakeVoiceCatalog.cs" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Trackdub.Application\Trackdub.Application.csproj" />
    <ProjectReference Include="..\..\src\Trackdub.Domain\Trackdub.Domain.csproj" />
    <ProjectReference Include="..\..\src\Trackdub.Infrastructure\Trackdub.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Trackdub.TestDoubles\FakeTranslationLanguageRouter.cs" Link="TestDoubles\FakeTranslationLanguageRouter.cs" />
    <Compile Include="..\Trackdub.TestDoubles\FakeStudioSettingsService.cs" Link="TestDoubles\FakeStudioSettingsService.cs" />
    <Compile Include="..\Trackdub.TestDoubles\FakeCloudEgressConsentService.cs" Link="TestDoubles\FakeCloudEgressConsentService.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Fixtures\benchmark-evidence-schema-v1.json"
             Link="Fixtures\benchmark-evidence-schema-v1.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
