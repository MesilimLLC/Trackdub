<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0;net11.0-windows10.0.19041.0</TargetFrameworks>
    <!-- Directory.Build.props supplies TargetFramework; clear it when multi-targeting. -->
    <TargetFramework Condition="'$(TargetFrameworks)' != ''" />
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Legacy benchmark tests still have many setup/helper calls with omitted optional CancellationToken parameters. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0-windows10.0.19041.0'">
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DubBench\Trackdub.DubBench.csproj" />
    <ProjectReference Include="..\..\src\Trackdub.Contracts\Trackdub.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Trackdub.Benchmarks\Trackdub.Benchmarks.csproj" />
    <ProjectReference Include="..\..\src\Trackdub.Domain\Trackdub.Domain.csproj" />
    <ProjectReference Include="..\..\src\Trackdub.Inference\Trackdub.Inference.csproj" />
    <ProjectReference Include="..\..\src\Trackdub.Inference.Onnx\Trackdub.Inference.Onnx.csproj" />
    <ProjectReference Include="..\..\src\Trackdub.Application\Trackdub.Application.csproj" />
    <ProjectReference Include="..\..\src\Trackdub.Tools\Trackdub.Tools.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0-windows10.0.19041.0'">
    <ProjectReference Update="..\..\src\Trackdub.Benchmarks\Trackdub.Benchmarks.csproj"
                      SetTargetFramework="TargetFramework=net11.0-windows10.0.19041.0" />
    <ProjectReference Update="..\..\src\Trackdub.Inference.Onnx\Trackdub.Inference.Onnx.csproj"
                      SetTargetFramework="TargetFramework=net11.0-windows10.0.19041.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Trackdub.TestDoubles\RequiresBundledModelFactAttribute.cs" Link="TestDoubles\RequiresBundledModelFactAttribute.cs" />
    <Compile Include="..\Trackdub.TestDoubles\FakeWavHelper.cs" Link="TestDoubles\FakeWavHelper.cs" />
    <Compile Include="..\Trackdub.TestDoubles\SparseWaveStream.cs" Link="TestDoubles\SparseWaveStream.cs" />
    <Compile Include="..\Trackdub.TestDoubles\FakeMediaProbe.cs" Link="TestDoubles\FakeMediaProbe.cs" />
    <Compile Include="..\Trackdub.TestDoubles\FakePipelinePreFlightChecker.cs" Link="TestDoubles\FakePipelinePreFlightChecker.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Fixtures\benchmark-evidence-schema-v1.json"
             Link="Fixtures\benchmark-evidence-schema-v1.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
